# Public site URL (canonical origin). Leave unset during development.
# Production blocker: must be set to the purchased domain before launch.
NEXT_PUBLIC_SITE_URL=https://[DOMAIN-PENDING]

# Contact form API endpoint (implemented by a separate backend developer).
# When unset, the contact page shows the documented fallback state
# (form disabled, phone + email contact paths shown) instead of a broken form.
NEXT_PUBLIC_CONTACT_API_URL=

# Contact API request timeout in milliseconds.
NEXT_PUBLIC_CONTACT_API_TIMEOUT_MS=12000

# NEVER put AWS credentials, SES credentials, SMTP credentials, private API
# keys, or any secret in NEXT_PUBLIC_* variables — they are embedded in the
# public client bundle.
